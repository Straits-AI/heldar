# VisionOps Core — environment configuration
# Copy to .env and edit. Never commit .env (it holds camera credentials).

# ---- Database ----
# SQLite (default, zero-setup):
VISIONOPS_DATABASE_URL=sqlite:///./data/visionops.db
# PostgreSQL (production-style, via docker-compose):
# VISIONOPS_DATABASE_URL=postgresql+psycopg://visionops:visionops@localhost:5432/visionops

# ---- Storage paths (absolute or relative to repo root) ----
VISIONOPS_DATA_DIR=./data
VISIONOPS_RECORDINGS_DIR=./data/recordings
VISIONOPS_CLIPS_DIR=./data/clips
VISIONOPS_SNAPSHOTS_DIR=./data/snapshots

# ---- Media tooling ----
VISIONOPS_FFMPEG_BIN=ffmpeg
VISIONOPS_FFPROBE_BIN=ffprobe

# ---- MediaMTX (live-view gateway) ----
VISIONOPS_MEDIAMTX_API_URL=http://127.0.0.1:9997
VISIONOPS_MEDIAMTX_HLS_BASE=http://127.0.0.1:8888
VISIONOPS_MEDIAMTX_RTSP_BASE=rtsp://127.0.0.1:8554
VISIONOPS_MEDIAMTX_WEBRTC_BASE=http://127.0.0.1:8889

# ---- Recording policy (conservative defaults — host disk is limited) ----
VISIONOPS_RECORDER_ENABLED=true
VISIONOPS_DEFAULT_SEGMENT_SECONDS=60
VISIONOPS_DEFAULT_RETENTION_HOURS=24
VISIONOPS_INDEXER_INTERVAL_S=10
VISIONOPS_HEALTH_INTERVAL_S=15
VISIONOPS_RETENTION_INTERVAL_S=300

# ---- Storage limits & observability (Stage 1) ----
# Soft cap on total recording footprint; oldest unlocked segments pruned above this.
VISIONOPS_MAX_RECORDINGS_GB=20
# Hard floor on free disk space; oldest unlocked segments pruned when free space drops below this.
VISIONOPS_MIN_FREE_DISK_GB=5
# Optional webhook that receives warning/critical events as JSON (alerting). Leave unset to disable.
# VISIONOPS_ALERT_WEBHOOK_URL=https://hooks.example.com/visionops
VISIONOPS_NOTIFIER_INTERVAL_S=15
# Prometheus scrapes GET /metrics; liveness GET /healthz; readiness GET /readyz.

# ---- API ----
VISIONOPS_API_HOST=0.0.0.0
VISIONOPS_API_PORT=8000
VISIONOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Real HikVision cameras live on 192.168.0.2 .. 192.168.0.12 ----
# RTSP requires credentials. Onboard a camera with POST /api/v1/cameras supplying
# address + username + password; URLs are auto-built from the vendor template.
# Example default credentials placeholders (DO NOT brute force — HikVision locks out):
# CAMERA_DEFAULT_USERNAME=admin
# CAMERA_DEFAULT_PASSWORD=
