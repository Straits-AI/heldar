{
  "name": "heldar-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Heldar Core operator dashboard",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:tls": "playwright test --config playwright.tls.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "hls.js": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
