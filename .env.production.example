# Heldar Core — PRODUCTION profile (internet-exposed remote access)
#
# This is the hardened overlay for a deployment reachable from the public internet (via the WebRTC
# rendezvous). Copy the relevant lines into your `.env` ON TOP of `.env.example`. The plain LAN
# appliance does NOT need these — its defaults are intentionally permissive for a trusted network.
# Full rationale + checklist: docs/PRODUCTION.md. Never commit a real `.env` (it holds secrets).

# ---- Authentication (REQUIRED for any networked deployment) ----
# Auth off = every request is a synthetic admin. The kernel REFUSES TO BOOT if a rendezvous is
# configured while this is false.
HELDAR_AUTH_ENABLED=true
# Mark the session cookie Secure (requires HTTPS). The rendezvous terminates TLS, so set this true.
HELDAR_AUTH_COOKIE_SECURE=true
# Bound a stolen session: a shorter absolute lifetime + an idle timeout.
HELDAR_SESSION_TTL_HOURS=4
HELDAR_SESSION_IDLE_TIMEOUT_MIN=30
# Sliding expiry stays OFF for an internet-exposed box: a short absolute TTL is the point here.
HELDAR_SESSION_MAX_LIFETIME_HOURS=0

# ---- Brute-force lockout (per account; complements the rendezvous per-IP rate limit) ----
HELDAR_LOGIN_MAX_FAILURES=5
HELDAR_LOGIN_LOCKOUT_MIN=15

# ---- Encryption at rest for camera credentials ----
# base64 of 32 random bytes, e.g.  openssl rand -base64 32
# Unset = plaintext at rest. When set, existing plaintext passwords are sealed on next boot.
HELDAR_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTES
# To rotate the key: set the OLD key here, the new key above, then run `heldar-core rekey-secrets`.
# Losing the key with no OLD key to recover from means re-entering every camera password.
# HELDAR_SECRET_KEY_OLD=

# ---- On-demand export cap ----
# Cumulative size limit for archive (.zip) exports so they can't fill the disk (default 50 GiB).
# HELDAR_ARCHIVE_DIR_MAX_BYTES=53687091200

# ---- CORS ----
# Set this to the EXACT origin the dashboard is served from, e.g. https://cam.example.com.
# Empty = no CORS layer at all (same-origin only). That is the safe default and is all you need when
# the dashboard is served from this box — which it is in the reference deployment.
# A literal `*` allows EVERY origin; strict-prod refuses to boot with it. Never ship `*`.
HELDAR_CORS_ORIGINS=

# ---- Remote access (the box dials OUT to the rendezvous; no inbound port) ----
HELDAR_REMOTE_RENDEZVOUS_URL=https://your-rendezvous.example.workers.dev
HELDAR_SITE_ID=a-stable-id-for-this-box
# The per-box token minted with the enrollment CLI, bound to HELDAR_SITE_ID (see apps/edge/README.md).
HELDAR_CP_TOKEN=THE_TOKEN_MINTED_FOR_THIS_SITE
# Optional: bring your own STUN/TURN (MediaMTX webrtcICEServers2 JSON); else the rendezvous TURN is used.
# HELDAR_WEBRTC_ICE_SERVERS=

# ---- Strict mode ----
# Turn the production guardrails into hard boot failures (instead of warnings) so a misconfigured
# cookie-Secure / idle-timeout / plaintext-credentials deployment can't start. Recommended for prod.
HELDAR_STRICT_PROD=true

# ---- Deployment tier ----
# Declares this box as production. Auth-off on a non-loopback bind becomes a hard boot refusal, and
# HELDAR_MACHINE_AUTH is promoted to `enforce`. Use `production-lan` for a box reachable only from the
# trusted LAN; `production-remote` when it is reached through the rendezvous (which is this file's
# case, so that is what is set here).
HELDAR_DEPLOYMENT_MODE=production-remote

# ---- Machine-credential enforcement ----
# Capability enforcement for API keys that carry no explicit capability grant. `enforce` narrows the
# legacy `integration` role to the capability set a real AI worker actually calls. SERVER-SIDE ONLY:
# it changes no client protocol, and the enforced set deliberately keeps every endpoint a worker uses,
# so it is safe to enable on an existing deployment. Set explicitly rather than relying on the
# deployment-mode promotion, so this file states the posture it runs at. Leave it at the default
# `warn` for a day first if you want the once-per-hour log naming which keys would be narrowed.
HELDAR_MACHINE_AUTH=enforce

# ---- AI ingest provenance (frame tickets) — READ BEFORE ENABLING ----
# Requires every AI detection batch to carry a server-issued frame ticket proving the worker actually
# held the frame it is reporting on. Unlike HELDAR_MACHINE_AUTH this is a CLIENT PROTOCOL requirement:
# `enforce` returns 401 frame_ticket_required to every worker that does not yet mint one, including
# third-party and not-yet-upgraded workers. Detection then stops on a box whose recording, health and
# dashboard all still look fine.
#
# For that reason it is NOT promoted by HELDAR_DEPLOYMENT_MODE — no deployment label turns it on — and
# it is left commented here rather than shipped enabled.
#
# Roll it out in this order:
#   1. Leave it unset. The default is `warn`: ticketless ingest is still ACCEPTED, and every
#      credential posting without a ticket is logged once an hour (target `heldar::security`) with an
#      `ingest_unleased` event. That hourly log is the list of clients that would break.
#   2. Upgrade every worker on that list (see docs/AI-WORKERS.md §5.0) until a full hour passes with
#      nothing logged.
#   3. Only then uncomment the line below and restart.
# The effective tier is reported at boot (banner: ENFORCED / NOT ENFORCED) and on GET /api/v1/system
# under `enforcement`, so you never have to infer it from which variables you remember setting.
# HELDAR_INGEST_PROVENANCE=enforce

# The Worker (apps/edge) also needs its secrets set — see docs/PRODUCTION.md:
#   wrangler secret put BOX_ENROLL_SECRET RENDEZVOUS_SECRET RELAY_CAP_SECRET TURN_API_TOKEN [TURNSTILE_SECRET]
# and NEVER set ALLOW_OPEN_BOX_AUTH in production.
