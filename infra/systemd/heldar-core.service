[Unit]
Description=Heldar Core — media/DVR recorder + perception kernel
Documentation=https://github.com/Straits-AI/heldar
After=network-online.target mediamtx.service
Wants=network-online.target

[Service]
Type=simple
# Runs as a dedicated non-root user. StateDirectory creates + owns /var/lib/heldar.
User=heldar
Group=heldar
StateDirectory=heldar
Environment=HELDAR_DATA_DIR=/var/lib/heldar
Environment=HELDAR_DATABASE_URL=sqlite:///var/lib/heldar/heldar.db
Environment=HELDAR_API_HOST=0.0.0.0
# Operator overrides (HELDAR_WG_MANAGED, SMTP, camera creds, etc). Optional — `-` = ignore if absent.
EnvironmentFile=-/etc/heldar/heldar.env
ExecStart=/usr/local/bin/heldar-core
Restart=on-failure
RestartSec=3

# ---- Kernel-managed WireGuard remote access (ONLY needed when HELDAR_WG_MANAGED=true) ----
# systemd is already PID 1, so it injects CAP_NET_ADMIN into this NON-ROOT service at launch — no
# setcap, no sudo, no Docker. This is how the appliance manages its own heldar0 without privilege escalation.
# Remove these two lines if you don't enable remote access (core needs no capabilities otherwise).
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

# ---- Hardening (compatible with bringing up heldar0 + writing the data dir) ----
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/heldar
# Do NOT set PrivateNetwork=yes (it isolates the netns and breaks reachability), and do not over-restrict
# RestrictAddressFamilies — `ip`/`wg` need AF_NETLINK + AF_INET/AF_INET6.

[Install]
WantedBy=multi-user.target
