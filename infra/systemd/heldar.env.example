# /etc/heldar/heldar.env — operator config for the native (systemd) appliance install.
# Copy to /etc/heldar/heldar.env and edit. See .env.example (repo root) for the full variable list.

# ---- Kernel-managed WireGuard remote access ----
# With this on, heldar-core brings up its own isolated WireGuard interface (the systemd unit grants the
# CAP_NET_ADMIN it needs — no setcap, no sudo). It auto-selects a non-conflicting name/subnet/port.
HELDAR_WG_MANAGED=true
# HELDAR_WG_SUBNET=10.200.0.0/24
# HELDAR_WG_ENDPOINT=[2001:db8::1]:51820   # defaults to the host's public IPv6
# For LIVE video over the tunnel, point the media bases at the WireGuard host IP:
# HELDAR_MEDIAMTX_HLS_BASE=http://10.200.0.1:8888
# HELDAR_MEDIAMTX_WEBRTC_BASE=http://10.200.0.1:8889
